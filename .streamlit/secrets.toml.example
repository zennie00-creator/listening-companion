# Fill these in Streamlit's app-specific Secrets, never in GitHub.
# Existing Listening Companion API key; not the journal agent's key.
OPENAI_API_KEY = ""
OPENAI_MODEL = "gpt-4.1-mini"
STORAGE_BACKEND = "notion"
NOTION_TOKEN = ""
# Listening Companion 전용 페이지 ID. 개인 페이지 ID는 Git에 넣지 않습니다.
NOTION_PAGE_ID = ""
# Choose a private password of at least 12 characters, only in Secrets.
APP_PASSWORD = ""
# Alternatively use APP_PASSWORD_HASH generated by scripts/password_hash.py.
# APP_PASSWORD_HASH = ""
# PostgreSQL remains available as an alternative:
# STORAGE_BACKEND = "postgres"
# DATABASE_URL = "postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require"
LC_DEPLOYMENT_MODE = "cloud"
